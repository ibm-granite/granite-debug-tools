<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/pcm#"
     xml:base="https://w3id.org/pcm"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="http://schema.org/">
    <owl:Ontology rdf:about="https://w3id.org/pcm">
        <dc:creator rdf:resource="https://www.wikidata.org/wiki/Q54832532"/>
        <dc:title xml:lang="en">The Personal Conversational Memory Ontology</dc:title>
        <terms:abstract xml:lang="en">The Personal Conversational Memory (PCM) ontology is a multi-vocabulary schema for representing personal knowledge extracted from conversational interactions between users and AI agents. It reuses established vocabularies - Schema.org, OntoBio, FOAF, PROV-O, SKOS, the Relationship and BIO vocabularies, OpenCare, and CV/ResumeRDF - and defines custom extensions for concepts not adequately covered by existing standards, including personal preferences, problem and service events, and social media accounts. The ontology underpins the PCM pipeline for incremental personal knowledge graph construction, provenance tracking, and SPARQL-based retrieval over conversational memory.</terms:abstract>
        <terms:description xml:lang="en">A multi-vocabulary schema for personal knowledge graph extraction from conversational text, defining custom extensions for personal preferences, problem and service events, and social media accounts on top of established vocabularies.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-10</terms:modified>
        <schema:image rdf:resource="https://w3id.org/pcm/images/pcm-ontology-diagram.png"/>
        <rdfs:comment xml:lang="en">Schema for personal knowledge graph extraction from conversational text. Reuses Schema.org, OntoBio, FOAF, PROV-O, SKOS, Relationship vocab, BIO, OpenCare, and CV/ResumeRDF.</rdfs:comment>
        <rdfs:label xml:lang="en">The Personal Conversational Memory Ontology</rdfs:label>
        <owl:versionInfo>1.0</owl:versionInfo>
        <foaf:depiction rdf:resource="https://w3id.org/pcm/images/pcm-ontology-diagram.png"/>
    </owl:Ontology>
    


