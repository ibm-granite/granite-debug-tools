    <!-- 19. PCM CUSTOM EXTENSIONS                                    -->
    <!-- ============================================================ -->

    <owl:Class rdf:about="https://w3id.org/pcm#Preference">
        <rdfs:label xml:lang="en">Preference</rdfs:label>
        <rdfs:comment xml:lang="en">A personal preference expressed by a person.</rdfs:comment>
    </owl:Class>

    <owl:ObjectProperty rdf:about="https://w3id.org/pcm#hasPreference">
        <rdfs:label xml:lang="en">has preference</rdfs:label>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="https://w3id.org/pcm#Preference"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="https://w3id.org/pcm#preferenceType">
        <rdfs:label xml:lang="en">preference type</rdfs:label>
        <rdfs:comment xml:lang="en">Category of preference (e.g. food, music, brand).</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/pcm#Preference"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://w3id.org/pcm#preferenceValue">
        <rdfs:label xml:lang="en">preference value</rdfs:label>
        <rdfs:comment xml:lang="en">The value or target of the preference.</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/pcm#Preference"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:Class rdf:about="https://w3id.org/pcm#ProblemEvent">
        <rdfs:label xml:lang="en">Problem Event</rdfs:label>
        <rdfs:comment xml:lang="en">A problem or issue that occurred, affecting an entity.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://schema.org/Event"/>
    </owl:Class>

    <owl:DatatypeProperty rdf:about="https://w3id.org/pcm#problemType">
        <rdfs:label xml:lang="en">problem type</rdfs:label>
        <rdfs:comment xml:lang="en">Category of the problem (e.g. mechanical, software, health).</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/pcm#ProblemEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/pcm#affects">
        <rdfs:label xml:lang="en">affects</rdfs:label>
        <rdfs:comment xml:lang="en">Links a problem event to the entity it impacts.</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/pcm#ProblemEvent"/>
    </owl:ObjectProperty>

    <owl:Class rdf:about="https://w3id.org/pcm#ServiceEvent">
        <rdfs:label xml:lang="en">Service Event</rdfs:label>
        <rdfs:comment xml:lang="en">A service interaction such as repair, maintenance, or professional service.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://schema.org/Event"/>
    </owl:Class>

    <owl:DatatypeProperty rdf:about="https://w3id.org/pcm#serviceType">
        <rdfs:label xml:lang="en">service type</rdfs:label>
        <rdfs:comment xml:lang="en">Category of service (e.g. repair, maintenance, cleaning).</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/pcm#ServiceEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:Class rdf:about="https://w3id.org/pcm#Pet">
        <rdfs:label xml:lang="en">Pet</rdfs:label>
        <rdfs:comment xml:lang="en">A domestic animal kept for companionship.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
    </owl:Class>

    <owl:ObjectProperty rdf:about="https://w3id.org/pcm#hasPet">
        <rdfs:label xml:lang="en">has pet</rdfs:label>
        <rdfs:comment xml:lang="en">Links a person to a pet they own or care for.</rdfs:comment>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="https://w3id.org/pcm#Pet"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="https://w3id.org/pcm#petSpecies">
        <rdfs:label xml:lang="en">pet species</rdfs:label>
        <rdfs:comment xml:lang="en">The species or type of pet (e.g. dog, cat, parrot, fish).</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/pcm#Pet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://w3id.org/pcm#petBreed">
        <rdfs:label xml:lang="en">pet breed</rdfs:label>
        <rdfs:comment xml:lang="en">The breed of the pet, if applicable.</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/pcm#Pet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:Class rdf:about="https://w3id.org/pcm#SocialMediaAccount">
        <rdfs:label xml:lang="en">Social Media Account</rdfs:label>
        <rdfs:comment xml:lang="en">A user account on a social media platform.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://rdfs.org/sioc/ns#UserAccount"/>
    </owl:Class>

    <owl:ObjectProperty rdf:about="https://w3id.org/pcm#hasSocialAccount">
        <rdfs:label xml:lang="en">has social account</rdfs:label>
        <rdfs:comment xml:lang="en">Links a person to a social media account they own.</rdfs:comment>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="https://w3id.org/pcm#SocialMediaAccount"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="https://w3id.org/pcm#platform">
        <rdfs:label xml:lang="en">platform</rdfs:label>
        <rdfs:comment xml:lang="en">The social media platform name (e.g. Instagram, TikTok, YouTube).</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/pcm#SocialMediaAccount"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://w3id.org/pcm#followerCount">
        <rdfs:label xml:lang="en">follower count</rdfs:label>
        <rdfs:comment xml:lang="en">The number of followers on the social media account.</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/pcm#SocialMediaAccount"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:Class rdf:about="https://w3id.org/pcm#Clothing">
        <rdfs:label xml:lang="en">Clothing</rdfs:label>
        <rdfs:comment xml:lang="en">A wearable garment or accessory.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://schema.org/Product"/>
    </owl:Class>

    <owl:ObjectProperty rdf:about="https://w3id.org/pcm#wears">
        <rdfs:label xml:lang="en">wears</rdfs:label>
        <rdfs:comment xml:lang="en">Links a person to a clothing item they own or wear.</rdfs:comment>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="https://w3id.org/pcm#Clothing"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="https://w3id.org/pcm#clothingType">
        <rdfs:label xml:lang="en">clothing type</rdfs:label>
        <rdfs:comment xml:lang="en">The type of clothing (e.g. shoes, shirt, jacket, dress).</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/pcm#Clothing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:Class rdf:about="https://w3id.org/pcm#Plant">
        <rdfs:label xml:lang="en">Plant</rdfs:label>
        <rdfs:comment xml:lang="en">A plant grown or maintained by a person.</rdfs:comment>
    </owl:Class>

    <owl:ObjectProperty rdf:about="https://w3id.org/pcm#grows">
        <rdfs:label xml:lang="en">grows</rdfs:label>
        <rdfs:comment xml:lang="en">Links a person to a plant they grow or tend.</rdfs:comment>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="https://w3id.org/pcm#Plant"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="https://w3id.org/pcm#plantSpecies">
        <rdfs:label xml:lang="en">plant species</rdfs:label>
        <rdfs:comment xml:lang="en">The species or variety of plant (e.g. tomato, marigold, basil).</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/pcm#Plant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:Class rdf:about="https://w3id.org/pcm#Collection">
        <rdfs:label xml:lang="en">Collection</rdfs:label>
        <rdfs:comment xml:lang="en">A personal collection of items (e.g. coins, postcards, autographs).</rdfs:comment>
    </owl:Class>

    <owl:ObjectProperty rdf:about="https://w3id.org/pcm#hasCollection">
        <rdfs:label xml:lang="en">has collection</rdfs:label>
        <rdfs:comment xml:lang="en">Links a person to a collection they maintain.</rdfs:comment>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="https://w3id.org/pcm#Collection"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="https://w3id.org/pcm#collectionType">
        <rdfs:label xml:lang="en">collection type</rdfs:label>
        <rdfs:comment xml:lang="en">What is collected (e.g. coins, postcards, stamps, autographed baseballs).</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/pcm#Collection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://w3id.org/pcm#collectionSize">
        <rdfs:label xml:lang="en">collection size</rdfs:label>
        <rdfs:comment xml:lang="en">The number of items in the collection.</rdfs:comment>
        <rdfs:domain rdf:resource="https://w3id.org/pcm#Collection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:Class rdf:about="http://schema.org/Schedule">
        <rdfs:label xml:lang="en">Schedule</rdfs:label>
        <rdfs:comment xml:lang="en">A schedule defines the recurrence pattern for events or activities.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/DayOfWeek">
        <rdfs:label xml:lang="en">Day of Week</rdfs:label>
    </owl:Class>

    <rdf:Property rdf:about="http://schema.org/eventSchedule">
        <rdfs:label xml:lang="en">event schedule</rdfs:label>
        <rdfs:comment xml:lang="en">Associates an Event, Habit, or Activity with a recurring Schedule.</rdfs:comment>
    </rdf:Property>

    <rdf:Property rdf:about="http://schema.org/repeatFrequency">
        <rdfs:label xml:lang="en">repeat frequency</rdfs:label>
        <rdfs:comment xml:lang="en">How often the event/activity recurs, as ISO 8601 duration (e.g. P1W = weekly).</rdfs:comment>
        <rdfs:domain rdf:resource="http://schema.org/Schedule"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://schema.org/repeatCount">
        <rdfs:label xml:lang="en">repeat count</rdfs:label>
        <rdfs:comment xml:lang="en">Number of times per period (e.g. 3 for &apos;three times a week&apos;).</rdfs:comment>
        <rdfs:domain rdf:resource="http://schema.org/Schedule"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://schema.org/byDay">
        <rdfs:label xml:lang="en">by day</rdfs:label>
        <rdfs:comment xml:lang="en">Day(s) of the week on which the recurring event takes place.</rdfs:comment>
        <rdfs:domain rdf:resource="http://schema.org/Schedule"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://schema.org/byMonth">
        <rdfs:label xml:lang="en">by month</rdfs:label>
        <rdfs:comment xml:lang="en">Month(s) of the year (1-12) on which the recurring event takes place.</rdfs:comment>
        <rdfs:domain rdf:resource="http://schema.org/Schedule"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://schema.org/byMonthDay">
        <rdfs:label xml:lang="en">by month day</rdfs:label>
        <rdfs:comment xml:lang="en">Day(s) of the month (1-31) on which the recurring event takes place.</rdfs:comment>
        <rdfs:domain rdf:resource="http://schema.org/Schedule"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://schema.org/scheduleTimezone">
        <rdfs:label xml:lang="en">schedule timezone</rdfs:label>
        <rdfs:comment xml:lang="en">Timezone for the schedule (IANA identifier, e.g. America/New_York).</rdfs:comment>
        <rdfs:domain rdf:resource="http://schema.org/Schedule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdf:Property>

    <rdf:Property rdf:about="http://schema.org/duration">
        <rdfs:label xml:lang="en">duration</rdfs:label>
        <rdfs:comment xml:lang="en">The duration of each occurrence, in ISO 8601 format.</rdfs:comment>
    </rdf:Property>

    <!-- ============================================================ -->
    <!-- 20. CONVERSATION STRUCTURE (SIOC)                            -->
    <!-- ============================================================ -->

    <owl:Class rdf:about="http://rdfs.org/sioc/ns#Forum">
        <rdfs:label xml:lang="en">Forum</rdfs:label>
        <rdfs:comment xml:lang="en">A discussion area on which Posts or entries are made.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://rdfs.org/sioc/ns#Thread">
        <rdfs:label xml:lang="en">Thread</rdfs:label>
        <rdfs:comment xml:lang="en">A container for a series of threaded discussion Posts.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://rdfs.org/sioc/ns#Post">
        <rdfs:label xml:lang="en">Post</rdfs:label>
        <rdfs:comment xml:lang="en">An article or message posted to a Forum.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://rdfs.org/sioc/ns#UserAccount">
        <rdfs:label xml:lang="en">User Account</rdfs:label>
        <rdfs:comment xml:lang="en">A user account in an online community.</rdfs:comment>
    </owl:Class>

    <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#has_container">
        <rdfs:label xml:lang="en">has container</rdfs:label>
        <rdfs:comment xml:lang="en">The Container to which this Item belongs.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#has_creator">
        <rdfs:label xml:lang="en">has creator</rdfs:label>
        <rdfs:comment xml:lang="en">This is the UserAccount that made this resource.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdfs.org/sioc/ns#UserAccount"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="http://rdfs.org/sioc/ns#content">
        <rdfs:label xml:lang="en">content</rdfs:label>
        <rdfs:comment xml:lang="en">The content of the Item in plain text format.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#has_reply">
        <rdfs:label xml:lang="en">has reply</rdfs:label>
        <rdfs:comment xml:lang="en">Points to an Item or Post that is a reply to this Item.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#reply_of">
        <rdfs:label xml:lang="en">reply of</rdfs:label>
        <rdfs:comment xml:lang="en">Links to an Item that this Item is a reply to.</rdfs:comment>
        <owl:inverseOf rdf:resource="http://rdfs.org/sioc/ns#has_reply"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#account_of">
        <rdfs:label xml:lang="en">account of</rdfs:label>
        <rdfs:comment xml:lang="en">Refers to the foaf:Agent or foaf:Person who owns this UserAccount.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdfs.org/sioc/ns#UserAccount"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="https://w3id.org/pcm#role">
        <rdfs:label xml:lang="en">role</rdfs:label>
        <rdfs:comment xml:lang="en">The role of a message sender: user, assistant, or system.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdfs.org/sioc/ns#Post"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://w3id.org/pcm#turnIndex">
        <rdfs:label xml:lang="en">turn index</rdfs:label>
        <rdfs:comment xml:lang="en">The ordinal position of a message within a conversation thread.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdfs.org/sioc/ns#Post"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/created">
        <rdfs:label xml:lang="en">date created</rdfs:label>
        <rdfs:comment xml:lang="en">Date/time when the resource was created.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>

    <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#addressed_to">
        <rdfs:label xml:lang="en">addressed to</rdfs:label>
        <rdfs:comment xml:lang="en">A UserAccount that a Post was addressed to (e.g. DM recipient, @mention target).</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdfs.org/sioc/ns#Post"/>
        <rdfs:range rdf:resource="http://rdfs.org/sioc/ns#UserAccount"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/mbox">
        <rdfs:label xml:lang="en">email</rdfs:label>
        <rdfs:comment xml:lang="en">A personal mailbox (email address) as a mailto: URI.</rdfs:comment>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </owl:DatatypeProperty>

    <owl:ObjectProperty rdf:about="http://xmlns.com/foaf/0.1/img">
        <rdfs:label xml:lang="en">image</rdfs:label>
        <rdfs:comment xml:lang="en">A depiction of a person, typically a profile photo.</rdfs:comment>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    </owl:ObjectProperty>

    <rdf:Property rdf:about="http://schema.org/telephone">
        <rdfs:label xml:lang="en">telephone</rdfs:label>
        <rdfs:comment xml:lang="en">A telephone number.</rdfs:comment>
    </rdf:Property>

    <owl:DatatypeProperty rdf:about="https://w3id.org/pcm#timezone">
        <rdfs:label xml:lang="en">timezone</rdfs:label>
        <rdfs:comment xml:lang="en">IANA timezone identifier (e.g. America/New_York).</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://w3id.org/pcm#sourcePlatform">
        <rdfs:label xml:lang="en">source platform</rdfs:label>
        <rdfs:comment xml:lang="en">The communication platform this conversation was captured from (e.g. slack, chatgpt, email).</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdfs.org/sioc/ns#Thread"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

</rdf:RDF>
