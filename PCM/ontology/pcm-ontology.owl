<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/pcm/ontology/pcm-ontology.owl#"
     xml:base="https://w3id.org/pcm/ontology/pcm-ontology.owl"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:dct="http://purl.org/dc/terms/"
     xmlns:schema="http://schema.org/"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:ob="https://w3id.org/ontobio#"
     xmlns:rel="http://purl.org/vocab/relationship/"
     xmlns:bio="http://purl.org/vocab/bio/0.1/"
     xmlns:cv="http://rdfs.org/resume-rdf/cv.rdfs#"
     xmlns:opencare="https://w3id.org/opencare#"
     xmlns:pcm="https://w3id.org/pcm#"
     xmlns:sioc="http://rdfs.org/sioc/ns#">

    <!-- ============================================================ -->
    <!-- Ontology                                                     -->
    <!-- ============================================================ -->

    <owl:Ontology rdf:about="https://w3id.org/pcm/ontology/pcm-ontology.owl">
        <rdfs:label xml:lang="en">The Personal Conversational Memory Ontology</rdfs:label>
        <dc:title xml:lang="en">The Personal Conversational Memory Ontology</dc:title>
        <rdfs:comment xml:lang="en">Schema for personal knowledge graph extraction from conversational text. Reuses Schema.org, OntoBio, FOAF, PROV-O, SKOS, Relationship vocab, BIO, OpenCare, and CV/ResumeRDF.</rdfs:comment>
        <dct:created>2016/04/30</dct:created>
        <dct:modified>2026/03/10</dct:modified>
        <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dc:description rdf:resource="https://w3id.org/pcm/images/pcm-ontology-diagram.png"/>
        <dc:creator rdf:resource="https://w3id.org/scholarlydata/person/anna-lisa-gentile"/>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>

    <!-- ============================================================ -->
    <!-- 1. PERSON & IDENTITY                                         -->
    <!-- ============================================================ -->

    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Agent">
        <rdfs:label xml:lang="en">Agent</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Person">
        <rdfs:label xml:lang="en">Person</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/Person">
        <rdfs:label xml:lang="en">Person</rdfs:label>
        <owl:equivalentClass rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    </owl:Class>

    <owl:Class rdf:about="https://w3id.org/ontobio#Man">
        <rdfs:label xml:lang="en">Man</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    </owl:Class>

    <owl:Class rdf:about="https://w3id.org/ontobio#Woman">
        <rdfs:label xml:lang="en">Woman</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/GenderType">
        <rdfs:label xml:lang="en">Gender Type</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/Language">
        <rdfs:label xml:lang="en">Language</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="https://w3id.org/ontobio#EthnicGroup">
        <rdfs:label xml:lang="en">Ethnic Group</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="https://w3id.org/ontobio#Religion">
        <rdfs:label xml:lang="en">Religion</rdfs:label>
    </owl:Class>

    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/name">
        <rdfs:label xml:lang="en">name</rdfs:label>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/firstName">
        <rdfs:label xml:lang="en">first name</rdfs:label>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/family_name">
        <rdfs:label xml:lang="en">family name</rdfs:label>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/nick">
        <rdfs:label xml:lang="en">nickname</rdfs:label>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <rdf:Property rdf:about="http://schema.org/name">
        <rdfs:label xml:lang="en">name</rdfs:label>
    </rdf:Property>

    <rdf:Property rdf:about="http://schema.org/description">
        <rdfs:label xml:lang="en">description</rdfs:label>
    </rdf:Property>

    <rdf:Property rdf:about="http://schema.org/alternateName">
        <rdfs:label xml:lang="en">alternate name</rdfs:label>
    </rdf:Property>

    <rdf:Property rdf:about="http://schema.org/identifier">
        <rdfs:label xml:lang="en">identifier</rdfs:label>
        <rdfs:comment xml:lang="en">Any kind of identifier (e.g. social media handle, ISBN, account ID).</rdfs:comment>
    </rdf:Property>

    <owl:ObjectProperty rdf:about="http://schema.org/gender">
        <rdfs:label xml:lang="en">gender</rdfs:label>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="http://schema.org/GenderType"/>
    </owl:ObjectProperty>

    <rdf:Property rdf:about="http://schema.org/knowsLanguage">
        <rdfs:label xml:lang="en">knows language</rdfs:label>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    </rdf:Property>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasEthnicity">
        <rdfs:label xml:lang="en">has ethnicity</rdfs:label>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="https://w3id.org/ontobio#EthnicGroup"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#followsReligion">
        <rdfs:label xml:lang="en">follows religion</rdfs:label>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="https://w3id.org/ontobio#Religion"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="https://w3id.org/ontobio#hasGoal">
        <rdfs:label xml:lang="en">has goal</rdfs:label>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://purl.org/vocab/bio/0.1/biography">
        <rdfs:label xml:lang="en">biography</rdfs:label>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:ObjectProperty rdf:about="http://xmlns.com/foaf/0.1/interest">
        <rdfs:label xml:lang="en">interest</rdfs:label>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    </owl:ObjectProperty>

    <!-- ============================================================ -->
    <!-- 2. FAMILY RELATIONSHIPS (OntoBio)                            -->
    <!-- ============================================================ -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasFamilyRelation">
        <rdfs:label xml:lang="en">has family relation</rdfs:label>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasParent">
        <rdfs:label xml:lang="en">has parent</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasFamilyRelation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#isParentOf">
        <rdfs:label xml:lang="en">is parent of</rdfs:label>
        <owl:inverseOf rdf:resource="https://w3id.org/ontobio#hasParent"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasFather">
        <rdfs:label xml:lang="en">has father</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasParent"/>
        <rdfs:range rdf:resource="https://w3id.org/ontobio#Man"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasMother">
        <rdfs:label xml:lang="en">has mother</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasParent"/>
        <rdfs:range rdf:resource="https://w3id.org/ontobio#Woman"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasChild">
        <rdfs:label xml:lang="en">has child</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasFamilyRelation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasSon">
        <rdfs:label xml:lang="en">has son</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasChild"/>
        <rdfs:range rdf:resource="https://w3id.org/ontobio#Man"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasDaughter">
        <rdfs:label xml:lang="en">has daughter</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasChild"/>
        <rdfs:range rdf:resource="https://w3id.org/ontobio#Woman"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasSibling">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:label xml:lang="en">has sibling</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasFamilyRelation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasBrother">
        <rdfs:label xml:lang="en">has brother</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasSibling"/>
        <rdfs:range rdf:resource="https://w3id.org/ontobio#Man"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasSister">
        <rdfs:label xml:lang="en">has sister</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasSibling"/>
        <rdfs:range rdf:resource="https://w3id.org/ontobio#Woman"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasSpouse">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:label xml:lang="en">has spouse</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasFamilyRelation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasHusband">
        <rdfs:label xml:lang="en">has husband</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasSpouse"/>
        <rdfs:range rdf:resource="https://w3id.org/ontobio#Man"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasWife">
        <rdfs:label xml:lang="en">has wife</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasSpouse"/>
        <rdfs:range rdf:resource="https://w3id.org/ontobio#Woman"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasGrandParent">
        <rdfs:label xml:lang="en">has grandparent</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasFamilyRelation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasUncle">
        <rdfs:label xml:lang="en">has uncle</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasFamilyRelation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasAunt">
        <rdfs:label xml:lang="en">has aunt</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasFamilyRelation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasCousin">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:label xml:lang="en">has cousin</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasFamilyRelation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasNephew">
        <rdfs:label xml:lang="en">has nephew</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasFamilyRelation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasNiece">
        <rdfs:label xml:lang="en">has niece</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasFamilyRelation"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#hasInLaw">
        <rdfs:label xml:lang="en">has in-law</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#hasFamilyRelation"/>
    </owl:ObjectProperty>

    <!-- ============================================================ -->
    <!-- 3. SOCIAL RELATIONSHIPS (Relationship vocab)                 -->
    <!-- ============================================================ -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ontobio#socialRelationOf">
        <rdfs:label xml:lang="en">social relation of</rdfs:label>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://purl.org/vocab/relationship/friendOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:label xml:lang="en">friend of</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#socialRelationOf"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://purl.org/vocab/relationship/closeFriendOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:label xml:lang="en">close friend of</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://purl.org/vocab/relationship/friendOf"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://purl.org/vocab/relationship/acquaintanceOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:label xml:lang="en">acquaintance of</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#socialRelationOf"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://purl.org/vocab/relationship/colleagueOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:label xml:lang="en">colleague of</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#socialRelationOf"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://purl.org/vocab/relationship/worksWith">
        <rdfs:label xml:lang="en">works with</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#socialRelationOf"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://purl.org/vocab/relationship/neighborOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:label xml:lang="en">neighbor of</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#socialRelationOf"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://purl.org/vocab/relationship/mentorOf">
        <rdfs:label xml:lang="en">mentor of</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#socialRelationOf"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://purl.org/vocab/relationship/apprenticeTo">
        <rdfs:label xml:lang="en">apprentice to</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#socialRelationOf"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://purl.org/vocab/relationship/engagedTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:label xml:lang="en">engaged to</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontobio#socialRelationOf"/>
    </owl:ObjectProperty>

    <!-- ============================================================ -->
    <!-- 4. ACTIONS (Schema.org)                                      -->
    <!-- ============================================================ -->

    <owl:Class rdf:about="http://schema.org/Action">
        <rdfs:label xml:lang="en">Action</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/CreateAction">
        <rdfs:label xml:lang="en">Create Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/Action"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/UpdateAction">
        <rdfs:label xml:lang="en">Update Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/Action"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/DeleteAction">
        <rdfs:label xml:lang="en">Delete Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/Action"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/ReadAction">
        <rdfs:label xml:lang="en">Read Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/Action"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/WriteAction">
        <rdfs:label xml:lang="en">Write Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/Action"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/SearchAction">
        <rdfs:label xml:lang="en">Search Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/Action"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/CommunicateAction">
        <rdfs:label xml:lang="en">Communicate Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/Action"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/AchieveAction">
        <rdfs:label xml:lang="en">Achieve Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/Action"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/AssessAction">
        <rdfs:label xml:lang="en">Assess Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/Action"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/ConsumeAction">
        <rdfs:label xml:lang="en">Consume Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/Action"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/InteractAction">
        <rdfs:label xml:lang="en">Interact Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/Action"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/OrganizeAction">
        <rdfs:label xml:lang="en">Organize Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/Action"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/PlayAction">
        <rdfs:label xml:lang="en">Play Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/Action"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/TradeAction">
        <rdfs:label xml:lang="en">Trade Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/Action"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/TransferAction">
        <rdfs:label xml:lang="en">Transfer Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/Action"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/BuyAction">
        <rdfs:label xml:lang="en">Buy Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/TradeAction"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/PayAction">
        <rdfs:label xml:lang="en">Pay Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/TradeAction"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/RepairAction">
        <rdfs:label xml:lang="en">Repair Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/Action"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/ReviewAction">
        <rdfs:label xml:lang="en">Review Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/AssessAction"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/MoveAction">
        <rdfs:label xml:lang="en">Move Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/Action"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/TravelAction">
        <rdfs:label xml:lang="en">Travel Action</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://schema.org/MoveAction"/>
    </owl:Class>

    <owl:Class rdf:about="http://schema.org/UseAction">
        <rdfs:label xml:lang="en">Use Action</rdfs:label>
